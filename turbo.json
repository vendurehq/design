{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json", "$TURBO_ROOT$/packages/design-lint/biome/**"]
    },
    "@vendure-io/storybook#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/packages/design-lint/biome/**",
        "$TURBO_ROOT$/packages/ui/stories/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "check-freshness": {
      "outputs": []
    },
    "pack:check": {
      "outputs": []
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["src/css/**"],
      "inputs": ["src/tokens/**", "scripts/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
