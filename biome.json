{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.changeset",
      "!**/bun.lock",
      "!**/storybook-static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off",
        "useFocusableInteractive": "off",
        "noRedundantRoles": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsForRole": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/components/atoms/**", "**/hooks/use-mobile.ts", "packages/ui/stories/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "rules": { "recommended": false }, "domains": { "react": "none", "next": "none" } }
    },
    {
      "includes": [
        "packages/ui/src/**",
        "packages/ui/stories/**",
        "!packages/ui/src/components/atoms/chart.tsx"
      ],
      "plugins": ["./packages/design-lint/biome/no-raw-colors-warn.grit"]
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
