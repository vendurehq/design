{
  "name": "@vendure-io/ui",
  "version": "2.0.0-beta.8",
  "description": "React component library for Vendure, built on shadcn/ui and Tailwind v4",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/vendurehq/design/tree/main/packages/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/vendurehq/design.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/atoms/*": "./src/components/atoms/*.tsx",
    "./components/molecules/*": "./src/components/molecules/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check src/",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "next": ">=14",
    "next-themes": "^0.4.6"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@shikijs/transformers": "^3.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@vendure-io/design-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "motion": "^12.23.13",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.7.0",
    "recharts": "2.15.4",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "next-themes": "^0.4.6"
  }
}
